--!strict
-- Mobile hold-to-steer bookkeeping. (Regression for review finding: steering must never stick.)
-- Keys stand in for InputObjects (each touch finger / the mouse button).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HoldTracker = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("HoldTracker"))

return function(t)
	t.test("press holds, release lets go", function()
		local tracker = HoldTracker.new()
		HoldTracker.Press(tracker, "finger1", "Left")
		t.truthy(HoldTracker.IsHeld(tracker, "Left"))
		t.eq(HoldTracker.IsHeld(tracker, "Right"), false)
		t.truthy(HoldTracker.Release(tracker, "finger1"))
		t.eq(HoldTracker.IsHeld(tracker, "Left"), false)
	end)

	t.test("releasing an input that lifted somewhere else still ends its hold", function()
		local tracker = HoldTracker.new()
		HoldTracker.Press(tracker, "finger1", "Right")
		-- the finger lifts off-screen / over another control: released by key, not position
		HoldTracker.Release(tracker, "finger1")
		t.eq(HoldTracker.IsHeld(tracker, "Right"), false)
	end)

	t.test("two fingers on one button: lifting one keeps it held", function()
		local tracker = HoldTracker.new()
		HoldTracker.Press(tracker, "finger1", "Left")
		HoldTracker.Press(tracker, "finger2", "Left")
		HoldTracker.Release(tracker, "finger1")
		t.truthy(HoldTracker.IsHeld(tracker, "Left"), "still held by finger2")
		HoldTracker.Release(tracker, "finger2")
		t.eq(HoldTracker.IsHeld(tracker, "Left"), false)
	end)

	t.test("both buttons at once are tracked independently", function()
		local tracker = HoldTracker.new()
		HoldTracker.Press(tracker, "finger1", "Left")
		HoldTracker.Press(tracker, "finger2", "Right")
		t.truthy(HoldTracker.IsHeld(tracker, "Left") and HoldTracker.IsHeld(tracker, "Right"))
		HoldTracker.Release(tracker, "finger2")
		t.truthy(HoldTracker.IsHeld(tracker, "Left"))
		t.eq(HoldTracker.IsHeld(tracker, "Right"), false)
	end)

	t.test("Clear drops every hold (run ended, buttons hidden, focus lost)", function()
		local tracker = HoldTracker.new()
		HoldTracker.Press(tracker, "finger1", "Left")
		HoldTracker.Press(tracker, "mouse", "Right")
		HoldTracker.Clear(tracker)
		t.eq(HoldTracker.IsHeld(tracker, "Left"), false)
		t.eq(HoldTracker.IsHeld(tracker, "Right"), false)
		t.eq(HoldTracker.IsTracking(tracker, "finger1"), false)
	end)

	t.test("releasing an unknown or already-released input is harmless", function()
		local tracker = HoldTracker.new()
		t.eq(HoldTracker.Release(tracker, "ghost"), false)
		HoldTracker.Press(tracker, "finger1", "Left")
		HoldTracker.Release(tracker, "finger1")
		t.eq(HoldTracker.Release(tracker, "finger1"), false)
		t.eq(HoldTracker.Release(tracker, nil), false)
	end)

	t.test("ReleaseButton ends only that button's holds", function()
		local tracker = HoldTracker.new()
		HoldTracker.Press(tracker, "finger1", "Left")
		HoldTracker.Press(tracker, "finger2", "Right")
		HoldTracker.ReleaseButton(tracker, "Left")
		t.eq(HoldTracker.IsHeld(tracker, "Left"), false)
		t.truthy(HoldTracker.IsHeld(tracker, "Right"))
	end)

	t.test("sliding off a button: IsInside detects leaving its rectangle", function()
		local position = Vector2.new(24, 500)
		local size = Vector2.new(150, 150)
		t.truthy(HoldTracker.IsInside(Vector2.new(100, 575), position, size), "centre")
		t.truthy(HoldTracker.IsInside(Vector2.new(24, 500), position, size), "top-left edge")
		t.truthy(HoldTracker.IsInside(Vector2.new(174, 650), position, size), "bottom-right edge")
		t.eq(HoldTracker.IsInside(Vector2.new(175, 575), position, size), false, "just right of it")
		t.eq(HoldTracker.IsInside(Vector2.new(100, 499), position, size), false, "just above it")
	end)

	t.test("ButtonFor reports which button an input is holding", function()
		local tracker = HoldTracker.new()
		HoldTracker.Press(tracker, "finger1", "Right")
		t.eq(HoldTracker.ButtonFor(tracker, "finger1"), "Right")
		t.eq(HoldTracker.ButtonFor(tracker, "finger9"), nil)
	end)
end
